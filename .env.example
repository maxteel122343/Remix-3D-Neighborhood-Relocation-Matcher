# GEMINI_API_KEY: Required for Gemini AI API calls and Gemini TTS natural speech synthesis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for 3D Photorealistic Tiles, 2D Satellite Maps, and Places API.
VITE_GOOGLE_MAPS_API_KEY=
